DD_MODE=development
SERVICE_SITE=booking
HOST=127.0.0.1
PORT=3012
ALLOWED_ORIGINS=http://127.0.0.1:3000
MARKETING_ACTION_BASE_URL=http://127.0.0.1:3000
MARKETING_DATABASE_URL=
PAYLOAD_KEY=
PAYMENT_ENVIRONMENT=sandbox
MAIL_DELIVERY=capture
CAPTURE_DIRECTORY=
TRUSTED_PROXY_IPS=
BOOKING_MARKETING_BEARER=
# Production only: controlled recipients and the process-specific SMTP user.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_RECIPIENT_ALLOWLIST=
MAIL_RELEASE_ENABLED=false
# Atomic site aggregate and durable queue capacity (separate withdrawal lane).
MARKETING_SIGNUP_HOURLY=60
MARKETING_WITHDRAWAL_HOURLY=120
MARKETING_SIGNUP_QUEUE_MAX=50
MARKETING_WITHDRAWAL_QUEUE_MAX=20
MARKETING_PENDING_MAX=200
MARKETING_CLIENT_HOURLY=30
MARKETING_PREFIX_HOURLY=300
MARKETING_CLEANUP_BATCH=100
# Inquiry attempts and acknowledgements use separate shared capacity.
CONTACT_CLIENT_HOURLY=3
CONTACT_PREFIX_HOURLY=30
CONTACT_INQUIRY_HOURLY=30
CONTACT_ACK_HOURLY=30
CONTACT_INQUIRY_CONCURRENCY=2
CONTACT_ACK_CONCURRENCY=1
# Contact SMTP has a fixed cancellable 6s total deadline; leases expire after 30s.
