# Enable only with the primary profile; replace the provisional forms hostname.
server {
 listen 8080;
 server_name forms.didde-mie.com;
 access_log /dev/stdout safe;
 client_max_body_size 8k;
 add_header Referrer-Policy no-referrer always;
 add_header Cache-Control no-store always;
 location ^~ /internal/ { return 404; }
 location / {
  proxy_pass http://primary-communications:3011;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For "";
  proxy_set_header Host $host;
 }
}
server {
 listen 8080;
 server_name didde-mie.com;
 access_log /dev/stdout safe;
 add_header Referrer-Policy no-referrer always;
 location / { proxy_pass http://primary:8080; proxy_set_header Host $host; }
}
