diff --git a/apps/booking/src/app/styles.css b/apps/booking/src/app/styles.css
index 7faf69b..668518d 100644
--- a/apps/booking/src/app/styles.css
+++ b/apps/booking/src/app/styles.css
@@ -2381,3 +2381,20 @@ body:has(.legal-main) .legal-main {
 
 /* Studio details heading occupies the former desktop eyebrow position. */
 #booking-details .details-intro h3 { margin-top:0; }
+
+/* Readable studio details labels and desktop booking overview. */
+#booking-details .details-fields label,#booking-details .phone-field > label { font-size:17px; line-height:1.4; letter-spacing:0; }
+#booking-details .details-fields small { font-size:14px; }
+.summary-header h3 { margin:0; }
+.summary-header { column-gap:12px; }
+.summary-fact { font-size:16px; gap:8px; }
+.summary-row { font-size:16px; line-height:1.5; }
+.summary-total span { font-size:17px; }
+@media (min-width:821px) and (max-width:1399px) {
+ .summary-header { grid-template-columns:minmax(0,1fr) max-content; grid-template-rows:repeat(3,auto); row-gap:9px; }
+ .summary-heading { grid-row:1 / 4; }
+ .summary-fact { grid-column:2; }
+}
+@media (min-width:821px) and (max-width:1100px) {
+ .booking-layout { grid-template-columns:minmax(0,1.2fr) minmax(360px,.8fr); }
+}
