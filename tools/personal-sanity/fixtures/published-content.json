    {
      "_id": "personal-page-privacy",
      "route": "/privacy",
      "title": "Privacy policy | DD — Didde-Mie Lykke From",
      "heading": "PRIVACY\nPOLICY.",
      "updatedLabel": "Last updated 25 September 2026",
      "introduction": [
        {
          "_type": "block",
          "_key": "80bbce9b9b93",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "4522a6896693",
              "text": "This policy explains how the DD website handles personal data when you visit the site, play a film, send an inquiry, or sign up for the newsletter.",
              "marks": []
            }
          ]
        }
      ],
      "sections": [
        {
          "_key": "section-1",
          "heading": "1. Controller",
          "body": [
            {
              "_type": "block",
              "_key": "4747b6443dfc",
              "style": "normal",
              "markDefs": [
                {
                  "_type": "link",
                  "_key": "a296ad09a90d",
                  "href": "mailto:contact@didde-mie.com",
                  "external": false
                }
              ],
              "children": [
                {
                  "_type": "span",
                  "_key": "1a987f3c9ff7",
                  "text": "DD Production, CVR no. 42234958, Rathsacksvej 3, 3., 1862 Frederiksberg C, Denmark. For privacy requests, email ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "933888ee53fc",
                  "text": "contact@didde-mie.com",
                  "marks": [
                    "a296ad09a90d"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "14774c127501",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-2",
          "heading": "2. Data and purposes",
          "body": [
            {
              "_type": "block",
              "_key": "8d1c8e0f7b39",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "16d2be18836d",
                  "text": "Contact inquiries:",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "0575062eb771",
                  "text": " We collect your name, email address, topic and message to reply. The legal basis is GDPR Article 6(1)(b) for a possible engagement or Article 6(1)(f), our legitimate interest in answering other inquiries. The form sends data to the DD communications service, which routes it through our email provider.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "6f905bc3159b",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "66b0e1400f56",
                  "text": "Newsletter:",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "26e25f4c8028",
                  "text": " If you sign up, we use your email address to send DD Production updates on Didde-Mie's work and dance videos. The basis is your consent under GDPR Article 6(1)(a) and the marketing rules. We record when and where you requested and confirmed the signup, the wording you accepted, and any withdrawal. A confirmation email is required before you receive newsletters. You can unsubscribe using the link supplied with newsletter messages, through the unsubscribe page, or by replying to us. Withdrawal does not affect other communications you requested.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "c7d473abc65f",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "efcdee60ef37",
                  "text": "Site operation:",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "5e4cd5341c7b",
                  "text": " The hosting provider may process IP addresses and technical request data to serve and secure the site. The legal basis is Article 6(1)(f), our legitimate interest in operating a secure website.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "3e63153b8d1a",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "1e07c48a040b",
                  "text": "External media:",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "382f5de2e813",
                  "text": " YouTube is contacted only when you choose to play a film on this page. YouTube may then receive your IP address and place or read cookies or similar identifiers according to its own settings. External profile and source links open their providers' sites when clicked.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "c36e98c42b61",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "29a50bd7de9a",
                  "text": "Please do not include sensitive personal data in the inquiry field. You need to provide your name, email and message for us to answer via the form.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-3",
          "heading": "3. Recipients and transfers",
          "body": [
            {
              "_type": "block",
              "_key": "8d7df11c4b79",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "90463856c1a7",
                  "text": "Relevant people working with DD, the website host, the DD communications service and our email provider may process inquiry, newsletter or technical data. Newsletter addresses are stored in a separate application database and confirmation messages are sent through Purelymail. YouTube and Storyblok act under their own terms when their content loads. We will verify the final provider list, processing agreements and any transfers outside the EU/EEA before launch, and add the transfer basis here if needed.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-4",
          "heading": "4. Retention",
          "body": [
            {
              "_type": "block",
              "_key": "fbcebfd4ea28",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "17e63b09bc67",
                  "text": "We normally delete inquiries within 12 months of the last relevant contact, unless they become part of a business relationship or a specific dispute. We keep active newsletter subscriptions while you remain subscribed. When you unsubscribe, we stop sending newsletters and retain only the minimum information needed to honor the withdrawal and document it, then review it for deletion when no longer needed. Unconfirmed signup links expire after 48 hours. Accounting records for completed work are retained for five years from the end of the relevant financial year. The hosting log retention period will be added after the deployment setup is confirmed.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-5",
          "heading": "5. Your rights",
          "body": [
            {
              "_type": "block",
              "_key": "42ce117e3c44",
              "style": "normal",
              "markDefs": [
                {
                  "_type": "link",
                  "_key": "f06e2f47c275",
                  "href": "https://www.datatilsynet.dk/borger/klage-til-datatilsynet",
                  "external": true
                }
              ],
              "children": [
                {
                  "_type": "span",
                  "_key": "e62f7027adf3",
                  "text": "You may request access, correction, erasure, restriction and, where applicable, data portability. You may object to processing based on legitimate interests. These rights depend on the circumstances, and legally required records cannot always be deleted immediately. Contact us at the address above. You can complain to the ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "cf6056caa6c0",
                  "text": "Danish Data Protection Agency",
                  "marks": [
                    "f06e2f47c275"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "f3d69ea9b261",
                  "text": ".",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-6",
          "heading": "6. Cookies and similar technologies",
          "body": [
            {
              "_type": "block",
              "_key": "c2489eda45aa",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "fbfe59555abe",
                  "text": "We will publish a separate, verified technology list and consent controls before adding optional analytics, advertising or embedded services that require consent. Playing a YouTube film initiates a connection to YouTube; choose an external YouTube link instead if you prefer to visit it directly. The final cookie information will state purposes, providers and lifetimes, and let you change any consent you give.",
                  "marks": []
                }
              ]
            }
          ]
        },
        {
          "_key": "section-7",
          "heading": "7. Changes",
          "body": [
            {
              "_type": "block",
              "_key": "c8296ff6564a",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "0516566a1be6",
                  "text": "We update this policy when features or providers change. The date above shows the latest revision.",
                  "marks": []
                }
              ]
            }
          ]
        }
      ],
      "contactLabel": "CONTACT ↗"
    },
