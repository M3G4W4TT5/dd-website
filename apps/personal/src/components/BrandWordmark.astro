---
import {imageUrl} from '../cms/content';
import type {Settings} from '../cms/model';

const {href = '/', settings} = Astro.props as {href?: string; settings: Settings};
---
<a class="wordmark wordmark-logo" href={href} aria-label={settings.navigation.wordmarkLabel}>
  <img src={imageUrl(settings.branding.wordmark, 1120, 'png')} alt="" width={1120} loading="eager" />
</a>
