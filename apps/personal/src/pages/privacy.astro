---
import BrandWordmark from "../components/BrandWordmark.astro";
import SiteFavicon from "../components/SiteFavicon.astro";
import {getSiteContent, pageFor} from '../cms/content';
import {RichText} from '../components/RichText';
import SiteFooter from '../components/SiteFooter.astro';
import PreviewEditing from '../components/PreviewEditing.astro';
import {stegaClean} from '@sanity/client/stega';
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/900.css";
import "../styles/site.css";
const content = await getSiteContent(Astro.locals.preview);
const {settings} = content;
const page = pageFor(content, "/privacy");
---
<!doctype html>
<html lang="en">
  <head><SiteFavicon settings={settings} /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>{stegaClean(page.title)}</title></head>
  <body>
    <header class="legal-header"><BrandWordmark settings={settings} /><a href="/#contact">{page.contactLabel}</a></header>
    <main class="legal-main"><h1>{page.heading.split("\n")[0]}<br /><span>{page.heading.split("\n").slice(1).join(" ")}</span></h1><p class="legal-date">{page.updatedLabel}</p>
      <div class="legal-content">
        <RichText value={page.introduction!} />
        {page.sections!.map(section => <section><h2>{section.heading}</h2><RichText value={section.body} /></section>)}
      </div>
    </main>
    <SiteFooter settings={settings} />
    <PreviewEditing />
  </body>
</html>
