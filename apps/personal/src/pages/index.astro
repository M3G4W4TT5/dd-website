---
import { ArrowUpRight } from "lucide-react";
import { Image, getImage } from "astro:assets";
import ddFlower from "../assets/branding/dd-flower-sharp-corners.png";
import flower from "../assets/branding/flower.png";
import BrandWordmark from "../components/BrandWordmark.astro";
import SiteFavicon from "../components/SiteFavicon.astro";
import { ContactPreview } from "../components/ContactPreview";
import { EditorialMotion } from "../components/EditorialMotion";
import { DesktopFlower } from "../components/DesktopFlower";
import { WorkSwitcher } from "../components/WorkSwitcher";
import { ClipReel } from "../components/ClipReel";
import { NewsletterSignup } from "../components/NewsletterSignup";
import { clips, media, work } from "../content";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/900.css";
import "../styles/site.css";

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || "http://127.0.0.1:3000";
const flowerMask = await getImage({ src: flower, width: 512, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion:reduce)").matches) {
        document.documentElement.classList.add("desktop-intro-active");
        // Release the page even if a client script or graphics resource cannot load.
        setTimeout(() => {
          if (!document.documentElement.classList.contains("desktop-intro-active")) return;
          if (document.documentElement.classList.contains("desktop-intro-running")) return;
          document.documentElement.classList.remove("desktop-intro-active", "desktop-intro-running");
          window.dispatchEvent(new Event("dd:intro-complete"));
        }, 4000);
      }
    </script>
    <SiteFavicon />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="DD — Didde-Mie Lykke From. Dancer and choreographer. Selected performance, film and modelling work." />
    <meta name="author" content="Didde-Mie Lykke From" />
    <title>DD — Didde-Mie Lykke From | Dancer / Choreographer</title>
  </head>
  <body>
    <div class="site-intro" aria-hidden="true">
      <div class="dd-loader-mark site-intro-mark"><span>D</span><span>D</span><i>.<b class="site-intro-baseline"></b></i></div>
    </div>
    <div class="site-intro-flower site-intro-flower-pink" aria-hidden="true" style={`--intro-flower-mask:url("${flowerMask.src}")`}></div>
    <div class="site-intro-flower site-intro-flower-negative" aria-hidden="true" style={`--intro-flower-mask:url("${flowerMask.src}")`}></div>
    <script>
      import { startDesktopIntro } from "../components/DesktopIntro";
      void startDesktopIntro();
    </script>
    <EditorialMotion client:load />
    <header class="site-header">
      <BrandWordmark href="#top" />
      <nav class="desktop-nav" aria-label="Main navigation"><a href="#work">Work</a><a href="#contact">Contact</a></nav>
      <a class="header-book" href={bookingUrl}>STUDIO BOOKING <ArrowUpRight size={18} /></a>
      <details class="mobile-menu"><summary>MENU <span>+</span></summary><nav aria-label="Mobile navigation"><a href="#work">Work</a><a href="#contact">Contact</a><a href={bookingUrl}>Studio booking</a></nav></details>
    </header>

    <main id="top" class="desktop-flower-page">
      <DesktopFlower client:load maskSrc={flowerMask.src} modelSrc="/branding/flower-globe-coin.glb" />
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-name"><h1 id="hero-heading">IN MOTION.</h1></div>
        <div class="hero-image" data-reveal>
          <img src={media.heroPortrait} alt="Close-up portrait of DD looking into the camera" fetchpriority="high" />
          <div class="hero-overlay-type" aria-hidden="true">DD.</div>
          <div class="hero-image-caption"><span>DD / HALO</span></div>
        </div>
      </section>

      <section class="intro-statement" aria-label="Introduction">
        <div class="section-index"><span>01 / INTRODUCTION</span></div>
        <p>DANCE.<br />CHOREOGRAPHY.<br /><em>MODELLING.</em></p>
        <ClipReel client:visible clips={clips} />
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-index"><span>02 / SELECTED WORK</span><span>PERFORMANCE / CAMPAIGNS</span></div>
        <div class="mega-heading"><h2 id="work-title">SELECTED<br /><span>WORK.</span></h2><p>Live dance, music films and modelling campaigns. Select a project for its credits and source.</p></div>
        <WorkSwitcher client:load items={work} />
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title" style={`--contact-image: url("${media.lowerBanner}")`}>
        <div class="section-index"><span>03 / GET IN TOUCH</span><span>DANCE / CHOREOGRAPHY / CAMPAIGNS</span></div>
        <div class="contact-layout"><div class="contact-copy"><h2 id="contact-title"><span>WORK<br />WITH</span><span class="contact-title-logo"><Image src={ddFlower} alt="DD." width={600} widths={[240, 360, 600]} sizes="(max-width: 500px) 26vw, (max-width: 760px) 184px, (max-width: 1653px) 17vw, 275px" format="webp" quality={95} loading="lazy" /></span></h2><p>For dance, choreography and campaign inquiries.</p></div><ContactPreview client:load /></div>
        <p class="contact-image-credit">DD / HALO</p>
      </section>

      <section class="links-section" aria-labelledby="links-title">
        <div class="section-index"><span>04 / LINKS</span><span>DD / ONLINE</span></div>
        <div class="links-layout">
          <div class="links-intro"><h2 id="links-title">FOLLOW<br />THE <span>WORK.</span></h2><NewsletterSignup client:load /></div>
          <div class="links-list">
            <a href={bookingUrl}><span>Studio booking</span><small>TTD STUDIO</small><ArrowUpRight size={23} /></a>
            <a href="https://www.instagram.com/diddemie_from/" target="_blank" rel="noopener noreferrer"><span>Instagram</span><small>@diddemie_from</small><ArrowUpRight size={23} /></a>
            <a href="https://www.tiktok.com/@diddemielykkefrom" target="_blank" rel="noopener noreferrer"><span>TikTok</span><small>@diddemielykkefrom</small><ArrowUpRight size={23} /></a>
            <a href="https://www.imdb.com/name/nm15290342/" target="_blank" rel="noopener noreferrer"><span>IMDb</span><small>PROFILE</small><ArrowUpRight size={23} /></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="footer-bottom"><span>© {new Date().getFullYear()} DD Production</span><a href="/privacy">PRIVACY POLICY</a><a class="footer-credit" href="https://memoryone.eu/" target="_blank" rel="noopener noreferrer"><span>Designed by</span><span class="footer-credit-logo" role="img" aria-label="Memory(One)"></span></a></div></footer>
    <script>
      const header = document.querySelector<HTMLElement>(".site-header");
      const heroImage = document.querySelector<HTMLElement>(".hero-image");
      const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");

      if (header && heroImage && menu) {
        // Clamp elastic overscroll so bouncing at either end cannot reverse direction.
        const scrollPosition = () => Math.max(0, Math.min(window.scrollY,
          document.documentElement.scrollHeight - window.innerHeight));
        let previousY = scrollPosition();
        const inHero = () => heroImage.getBoundingClientRect().bottom > header.offsetHeight;
        const setHidden = (hidden: boolean) => {
          if (hidden) {
            menu.open = false;
            if (document.activeElement instanceof HTMLElement && header.contains(document.activeElement)) {
              document.activeElement.blur();
            }
          }
          header.classList.toggle("is-scroll-hidden", hidden);
          header.inert = hidden;
        };

        window.addEventListener("scroll", () => {
          const currentY = scrollPosition();
          if (inHero() || currentY < previousY) setHidden(false);
          else if (currentY > previousY) setHidden(true);
          previousY = currentY;
        }, { passive: true });

        window.addEventListener("resize", () => {
          previousY = scrollPosition();
          if (inHero()) setHidden(false);
        });
        window.addEventListener("pageshow", () => {
          previousY = scrollPosition();
          setHidden(!inHero() && !menu.open);
        });
        menu.addEventListener("toggle", () => {
          if (menu.open) setHidden(false);
        });
        header.addEventListener("focusin", () => setHidden(false));
        menu.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
          link.addEventListener("click", () => { menu.open = false; });
        });
        setHidden(!inHero() && !menu.open);
      }
    </script>
  </body>
</html>
