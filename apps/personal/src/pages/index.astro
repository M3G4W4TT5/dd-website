---
import { ArrowUpRight } from "lucide-react";
import { ContactPreview } from "../components/ContactPreview";
import { EditorialMotion } from "../components/EditorialMotion";
import { FilmCarousel } from "../components/FilmCarousel";
import { WorkSwitcher } from "../components/WorkSwitcher";
import { NewsletterSignup } from "../components/NewsletterSignup";
import { films, media, work } from "../content";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/900.css";
import "../styles/site.css";

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || "http://127.0.0.1:3000";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="DD — Didde-Mie Lykke From. Dancer and choreographer. Selected performance, film and modelling work." />
    <meta name="author" content="Didde-Mie Lykke From" />
    <title>DD — Didde-Mie Lykke From | Dancer / Choreographer</title>
  </head>
  <body>
    <div class="site-intro" aria-hidden="true">
      <div class="dd-loader-mark site-intro-mark"><span>D</span><span>D</span><i>.</i></div>
    </div>
    <EditorialMotion client:load />
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="DD — top of page">DD<span>.</span><small>DIDDE-MIE LYKKE FROM</small></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href="#work">Work</a><a href="#films">Films</a><a href="#contact">Contact</a></nav>
      <a class="header-book" href={bookingUrl}>STUDIO BOOKING <ArrowUpRight size={18} /></a>
      <details class="mobile-menu"><summary>MENU <span>+</span></summary><nav aria-label="Mobile navigation"><a href="#work">Work</a><a href="#films">Films</a><a href="#contact">Contact</a><a href={bookingUrl}>Studio booking</a></nav></details>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-name"><h1 id="hero-heading">IN MOTION.</h1></div>
        <div class="hero-image" data-reveal>
          <img src={media.heroPortrait} alt="Close-up portrait of DD looking into the camera" fetchpriority="high" />
          <div class="hero-overlay-type" aria-hidden="true">DD.</div>
          <div class="hero-image-caption"><span>DD / HALO</span></div>
        </div>
      </section>

      <section class="intro-statement" aria-label="Introduction">
        <div class="section-index"><span>01 / INTRODUCTION</span></div>
        <p>DANCE.<br />CHOREOGRAPHY.<br /><em>MODELLING.</em></p>
        <div class="intro-detail"><span>DD / DIDDE-MIE LYKKE FROM</span><p>DD’s work moves between live stages, music films and campaigns. Selected credits include Dua Lipa’s Glastonbury set, Jungle’s <i>Back On 74</i> and Rosalía’s LUX tour. <a href="https://www.voguescandinavia.com/articles/didde-mie-beauty-guide" target="_blank" rel="noopener noreferrer">Tour source <ArrowUpRight size={14} /></a></p></div>
      </section>

      <div class="ticker" aria-hidden="true"><div>DANCE <span>✳</span> CHOREOGRAPHY <span>✳</span> MODELLING <span>✳</span> DANCE <span>✳</span> CHOREOGRAPHY <span>✳</span> MODELLING <span>✳</span></div></div>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-index"><span>02 / SELECTED WORK</span><span>PERFORMANCE / CAMPAIGNS</span></div>
        <div class="mega-heading"><h2 id="work-title">SELECTED<br /><span>WORK.</span></h2><p>Live dance, music films and modelling campaigns. Select a project for its credits and source.</p></div>
        <WorkSwitcher client:load items={work} />
      </section>

      <section class="social-section" id="films" aria-labelledby="films-title">
        <div class="section-index"><span>03 / WATCH</span></div>
        <div class="mega-heading"><h2 id="films-title">SELECTED<br /><span>FILMS.</span></h2><p>Performance films and a recording from Rosalía’s LUX tour. Select a film to watch it here.</p></div>
        <FilmCarousel client:visible films={films} />
      </section>

      <section class="links-section" aria-labelledby="links-title">
        <div class="section-index"><span>04 / LINKS</span><span>DD / ONLINE</span></div>
        <div class="links-layout">
          <div class="links-intro"><h2 id="links-title">FOLLOW<br />THE <span>WORK.</span></h2><NewsletterSignup client:load /></div>
          <div class="links-list">
            <a href={bookingUrl}><span>Studio booking</span><small>TTD STUDIO</small><ArrowUpRight size={23} /></a>
            <a href="https://www.instagram.com/diddemie_from/" target="_blank" rel="noopener noreferrer"><span>Instagram</span><small>@diddemie_from</small><ArrowUpRight size={23} /></a>
            <a href="https://www.tiktok.com/@diddemielykkefrom" target="_blank" rel="noopener noreferrer"><span>TikTok</span><small>@diddemielykkefrom</small><ArrowUpRight size={23} /></a>
            <a href="https://www.imdb.com/name/nm15290342/" target="_blank" rel="noopener noreferrer"><span>IMDb</span><small>PROFILE</small><ArrowUpRight size={23} /></a>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title" style={`--contact-image: url("${media.lowerBanner}")`}>
        <div class="section-index"><span>05 / GET IN TOUCH</span><span>DANCE / CHOREOGRAPHY / CAMPAIGNS</span></div>
        <div class="contact-layout"><div class="contact-copy"><h2 id="contact-title"><span class="contact-title-blend">WORK<br />WITH<br />DD</span><span class="contact-title-dot">.</span></h2><p>For dance, choreography and campaign inquiries.</p></div><ContactPreview client:load /></div>
        <p class="contact-image-credit">DD / HALO</p>
      </section>
    </main>

    <footer class="site-footer"><div class="footer-bottom"><span>© {new Date().getFullYear()} DD Production</span><a href="/privacy">PRIVACY POLICY</a><span class="footer-credit"><span>Designed by</span><span class="footer-credit-logo" role="img" aria-label="Memory(One)"></span></span></div></footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".mobile-menu nav a").forEach((link) => {
        link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
      });
    </script>
  </body>
</html>
