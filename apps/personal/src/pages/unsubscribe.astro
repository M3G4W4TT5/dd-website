---
import {getSiteContent, pageFor} from '../cms/content';
import PreviewEditing from '../components/PreviewEditing.astro';
import {stegaClean} from '@sanity/client/stega';
import SiteFavicon from "../components/SiteFavicon.astro";
import { NewsletterUnsubscribe } from "../components/NewsletterUnsubscribe";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/900.css";
import "../styles/site.css";
const content = await getSiteContent(Astro.locals.preview);
const {settings} = content;
const page = pageFor(content, "/unsubscribe");
---
<!doctype html>
<html lang="en">
  <head><SiteFavicon settings={settings} /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{stegaClean(page.title)}</title></head>
  <body>
    <main class="newsletter-unsubscribe-page">
      <a href="/" class="wordmark">DD<span>.</span></a>
      <h1>{page.heading}</h1>
      <p>{page.description}</p>
      <NewsletterUnsubscribe client:load copy={settings.unsubscribe} formsCopy={settings.forms} />
      <a href="/privacy">{page.privacy}</a>
    </main>
  <PreviewEditing /></body>
</html>
