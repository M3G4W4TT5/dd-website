# Leave all PRETIX_* fields empty to show clearly labeled sample availability.
# Set every field to read real one-hour slots from your local pretix event series.
PRETIX_API_BASE=http://127.0.0.1:8345
PRETIX_ORGANIZER_SLUG=
PRETIX_EVENT_SLUG=
PRETIX_ITEM_ID=
PRETIX_API_TOKEN=
# Separate token with order-view permission for all current and future organizer events.
# Never grant order access to the public availability token.
PRETIX_MANAGE_API_TOKEN=
# Separate least-privilege order-write token for change and provider-backed refund actions.
PRETIX_MANAGE_WRITE_API_TOKEN=
# Enable only after the hosted HTTPS sandbox checks in docs/BOOKING_MANAGEMENT_DEPLOYMENT.md.
BOOKING_SELF_SERVICE_ENABLED=false
# Pretix paid-order webhook HTTP Basic credentials. Use a random password of 32+ characters.
PRETIX_MANAGE_WEBHOOK_USER=
PRETIX_MANAGE_WEBHOOK_PASSWORD=
NEXT_PUBLIC_PERSONAL_URL=http://127.0.0.1:4321

# Booking web has no SMTP/marketing database credentials.
DD_MODE=development
PAYMENT_ENVIRONMENT=sandbox
CONTACT_BOOKING_ORIGIN=http://127.0.0.1:3000
BOOKING_PUBLIC_BASE_URL=http://127.0.0.1:3000
BOOKING_DATABASE_URL=
BOOKING_COMMUNICATIONS_URL=http://127.0.0.1:3012
BOOKING_MARKETING_BEARER=
PAYLOAD_KEY=
MANAGE_RECOVERY_HASH_KEY=

# Events catalog reads all events under the organizer with the same server-only token.
# Public customer-facing pretix URL (origin or path prefix), separate from PRETIX_API_BASE.
PRETIX_SHOP_BASE=
# Keep false until pretix room scheduling, rental collision prevention, and payment are verified.
PRETIX_EVENTS_CHECKOUT_ENABLED=false

# Local development only: show unpublished pretix test-mode events in the calendar.
PRETIX_DEV_DRAFT_EVENTS=false

# Local-only key for signing mock management bookings. Use at least 32 random characters.
# The preview action API derives its deadline from the signed booking and server time.
MANAGE_PREVIEW_SIGNING_KEY=

# Authenticated ingress only; identical private key in booking ingress header file.
BOOKING_INGRESS_KEY=
# Recovery defaults: each client 6/hour, IPv4 /24 or IPv6 /64 60/hour;
# 2 outstanding/client, 100 total; emergency bucket 200, refills one/10s.
RECOVERY_CLIENT_HOURLY=6
RECOVERY_PREFIX_HOURLY=60
RECOVERY_CLIENT_OUTSTANDING=2
RECOVERY_QUEUE_MAX=100
RECOVERY_EMERGENCY_BURST=200
RECOVERY_REFILL_SECONDS=10
# Shared durable catalog leases; no waiting queue, reserved fresh validation lane.
CATALOG_PUBLIC_CONCURRENCY=2
CATALOG_CHECKOUT_CONCURRENCY=1
CATALOG_DEADLINE_MS=25000
CATALOG_REQUEST_MAX=100
CATALOG_PAGE_MAX=20
CATALOG_CACHE_MS=5000
CATALOG_EMERGENCY_BURST=120
CATALOG_CLIENT_MINUTE=60
CATALOG_PREFIX_MINUTE=600
CHECKOUT_CLIENT_HOURLY=6
CHECKOUT_PREFIX_HOURLY=60
CHECKOUT_CONTACT_HOURLY=6
CHECKOUT_CLIENT_ACTIVE=1
CHECKOUT_CONTACT_ACTIVE=1
CHECKOUT_ACTIVE_MAX=40
